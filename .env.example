# Copy to .env and fill in ( .env is gitignored ):
#   cp .env.example .env
#
# TMDB — required for npm run letterboxd-import
# From https://www.themoviedb.org/settings/api — use the long API Read Access Token
# (JWT starting with eyJ), not the shorter API Key.
TMDB_READ_TOKEN=

# Netlify hosted access — only needed for `netlify dev` (optional locally)
# Set the same values in Netlify → Site configuration → Environment variables.
HOSTED_SITE_PASSWORD=

# Local dev server port (optional; default 8743)
# PORT=8743
